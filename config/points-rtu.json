{
  "common_address": 1,
  "name": "pi-rtu",
  "source": {
    "type": "modbus_rtu",
    "port": "/dev/ttyUSB0",
    "baud": 4800,
    "default_unit": 1,
    "timeout": 1.0,
    "map": [
      {"ioa": 1, "kind": "hr", "address": 6, "scale": 10, "signed": true},
      {"ioa": 2, "kind": "hr", "address": 7, "scale": 10},

      {"ioa": 5, "unit": 2, "kind": "coil", "address": 1280},
      {"ioa": 6, "unit": 2, "kind": "coil", "address": 1281},

      {"ioa": 7, "unit": 2, "kind": "bit", "address": 1024, "bit": 0},
      {"ioa": 8, "unit": 2, "kind": "bit", "address": 1024, "bit": 1}
    ]
  },
  "actuator": {
    "type": "modbus_rtu",
    "unit": 2,
    "coil_base": 1280,
    "channels": 4
  },
  "points": [
    {"ioa": 1,  "type": "M_ME_NC_1", "name": "Temp",        "value": 0.0,   "cyclic": true},
    {"ioa": 2,  "type": "M_ME_NC_1", "name": "Humidity",    "value": 0.0,   "cyclic": true},
    {"ioa": 5,  "type": "M_SP_NA_1", "name": "DO1_image",   "value": false},
    {"ioa": 6,  "type": "M_SP_NA_1", "name": "DO2_image",   "value": false},
    {"ioa": 7,  "type": "M_SP_NA_1", "name": "DO1_contact", "value": false},
    {"ioa": 8,  "type": "M_SP_NA_1", "name": "DO2_contact", "value": false},
    {"ioa": 10, "type": "C_SC_NA_1", "name": "DO1",         "value": false, "actuator": 0, "readback_ioa": 5}
  ]
}
